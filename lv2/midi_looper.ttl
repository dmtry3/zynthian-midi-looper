@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix time:   <http://lv2plug.in/ns/ext/time#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<urn:midilooper:looper#g_loop>   a pg:Group ; lv2:symbol "g_loop"   ; lv2:name "Loop"     ; lv2:index 0 ; lv2:displayPriority 60 .
<urn:midilooper:looper#g_layers> a pg:Group ; lv2:symbol "g_layers" ; lv2:name "Layers"   ; lv2:index 1 ; lv2:displayPriority 40 .
<urn:midilooper:looper#g_timing> a pg:Group ; lv2:symbol "g_timing" ; lv2:name "Timing"   ; lv2:index 2 ; lv2:displayPriority 50 .
<urn:midilooper:looper#g_quant>  a pg:Group ; lv2:symbol "g_quant"  ; lv2:name "Quantize" ; lv2:index 3 ; lv2:displayPriority 30 .
<urn:midilooper:looper#g_edit>   a pg:Group ; lv2:symbol "g_edit"   ; lv2:name "Edit"     ; lv2:index 4 ; lv2:displayPriority 20 .
<urn:midilooper:looper#g_slots>  a pg:Group ; lv2:symbol "g_slots"  ; lv2:name "Slots"    ; lv2:index 5 ; lv2:displayPriority 10 .

<urn:midilooper:looper>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "MIDI Looper" ;
    lv2:minorVersion 8 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    lv2:port
    [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , time:Position ;
        lv2:index 0 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ; lv2:symbol "midi_out" ; lv2:name "MIDI Out" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "rec" ; lv2:name "Rec/Dub" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 40 ; pg:group <urn:midilooper:looper#g_loop> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "play" ; lv2:name "Play/Stop" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ; pg:group <urn:midilooper:looper#g_loop> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "undo" ; lv2:name "Undo" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 20 ; pg:group <urn:midilooper:looper#g_loop> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "clear" ; lv2:name "Clear" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:midilooper:looper#g_loop> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "layer" ; lv2:name "Layer" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 8 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 40 ; pg:group <urn:midilooper:looper#g_layers> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "lmute" ; lv2:name "L Mute" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ; pg:group <urn:midilooper:looper#g_layers> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "ldel" ; lv2:name "L Delete" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 20 ; pg:group <urn:midilooper:looper#g_layers> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "redo" ; lv2:name "Redo" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:midilooper:looper#g_layers> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "length" ; lv2:name "Length" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 5 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:displayPriority 40 ; pg:group <urn:midilooper:looper#g_timing> ;
        lv2:scalePoint [ rdfs:label "Free" ; rdf:value 0 ] , [ rdfs:label "1 bar" ; rdf:value 1 ] ,
                       [ rdfs:label "2 bars" ; rdf:value 2 ] , [ rdfs:label "4 bars" ; rdf:value 3 ] ,
                       [ rdfs:label "8 bars" ; rdf:value 4 ] , [ rdfs:label "16 bars" ; rdf:value 5 ] ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "launch" ; lv2:name "Launch" ;
        lv2:default 2 ; lv2:minimum 1 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:displayPriority 30 ; pg:group <urn:midilooper:looper#g_timing> ;
        lv2:scalePoint [ rdfs:label "Beat" ; rdf:value 1 ] , [ rdfs:label "Bar" ; rdf:value 2 ] ,
                       [ rdfs:label "Loop" ; rdf:value 3 ] ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ; lv2:symbol "half" ; lv2:name "Half" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 20 ; pg:group <urn:midilooper:looper#g_timing> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ; lv2:symbol "double" ; lv2:name "Double" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:midilooper:looper#g_timing> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ; lv2:symbol "qgrid" ; lv2:name "Grid" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:displayPriority 40 ; pg:group <urn:midilooper:looper#g_quant> ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] , [ rdfs:label "1/4" ; rdf:value 1 ] ,
                       [ rdfs:label "1/8" ; rdf:value 2 ] , [ rdfs:label "1/16" ; rdf:value 3 ] ,
                       [ rdfs:label "1/32" ; rdf:value 4 ] ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ; lv2:symbol "qstr" ; lv2:name "Strength" ;
        lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 30 ; pg:group <urn:midilooper:looper#g_quant> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ; lv2:symbol "qtarget" ; lv2:name "Target" ;
        lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:displayPriority 20 ; pg:group <urn:midilooper:looper#g_quant> ;
        lv2:scalePoint [ rdfs:label "Starts" ; rdf:value 0 ] , [ rdfs:label "Ends" ; rdf:value 1 ] ,
                       [ rdfs:label "Both" ; rdf:value 2 ] ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ; lv2:symbol "qapply" ; lv2:name "Apply" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:midilooper:looper#g_quant> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ; lv2:symbol "elayer" ; lv2:name "Layer" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 8 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 30 ; pg:group <urn:midilooper:looper#g_edit> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 19 ; lv2:symbol "transp" ; lv2:name "Transpose" ;
        lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 20 ; pg:group <urn:midilooper:looper#g_edit> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 20 ; lv2:symbol "eapply" ; lv2:name "Apply" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:midilooper:looper#g_edit> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 21 ; lv2:symbol "slot" ; lv2:name "Slot" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 40 ; pg:group <urn:midilooper:looper#g_slots> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 22 ; lv2:symbol "save" ; lv2:name "Save" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ; pg:group <urn:midilooper:looper#g_slots> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 23 ; lv2:symbol "load" ; lv2:name "Load" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 20 ; pg:group <urn:midilooper:looper#g_slots> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 24 ; lv2:symbol "sdel" ; lv2:name "Del Slot" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:midilooper:looper#g_slots> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 25 ; lv2:symbol "qmask" ; lv2:name "Q Layers" ;
        lv2:default 255 ; lv2:minimum 0 ; lv2:maximum 255 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 26 ; lv2:symbol "export" ; lv2:name "Export" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 5 ; pg:group <urn:midilooper:looper#g_edit> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 27 ; lv2:symbol "ccm0" ; lv2:name "CC Ignore 0" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 28 ; lv2:symbol "ccm1" ; lv2:name "CC Ignore 1" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 29 ; lv2:symbol "ccm2" ; lv2:name "CC Ignore 2" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 30 ; lv2:symbol "ccm3" ; lv2:name "CC Ignore 3" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 31 ; lv2:symbol "ccm4" ; lv2:name "CC Ignore 4" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 32 ; lv2:symbol "ccm5" ; lv2:name "CC Ignore 5" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 33 ; lv2:symbol "ccm6" ; lv2:name "CC Ignore 6" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 34 ; lv2:symbol "ccm7" ; lv2:name "CC Ignore 7" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
        lv2:portProperty lv2:integer , pprops:notOnGUI ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 35 ; lv2:symbol "state" ; lv2:name "Out: State" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 7 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 36 ; lv2:symbol "pos" ; lv2:name "Out: Pos" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 37 ; lv2:symbol "bars" ; lv2:name "Out: Bars" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100000 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 38 ; lv2:symbol "layers" ; lv2:name "Out: Layers" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 8 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 39 ; lv2:symbol "mute" ; lv2:name "Out: Mute" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 255 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 40 ; lv2:symbol "confirm" ; lv2:name "Out: Confirm" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 41 ; lv2:symbol "bpm" ; lv2:name "Out: BPM" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 400 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 42 ; lv2:symbol "beat" ; lv2:name "Out: Beat" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 43 ; lv2:symbol "run" ; lv2:name "Out: Run" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 44 ; lv2:symbol "slots" ; lv2:name "Out: Slots" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 65535 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 45 ; lv2:symbol "msg" ; lv2:name "Out: Msg" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100000 ;
    ] .
